rules_version = '2';

// =====================================================================
//  InfraNexia — Absensi Magang
//  Prinsip: data absensi & pemetaan kartu TIDAK PERNAH disentuh browser.
//  Semua penulisan lewat API route Next.js (Firebase Admin SDK) yang
//  melewati rules ini, sehingga jam, status, keabsahan kartu, dan
//  validasi lokasi selalu ditentukan server.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Pembantu ----------
    function login() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function profil() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function punyaProfil() {
      return login() && exists(/databases/$(database)/documents/users/$(uid()));
    }
    function isAdmin() {
      return punyaProfil() && profil().role == 'admin';
    }
    function isPembina() {
      return punyaProfil() && profil().role in ['admin', 'pembimbing'];
    }
    // Field yang boleh diubah sendiri oleh pemilik akun
    function ubahanAman() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'foto', 'nim', 'kampus', 'jurusan']);
    }

    // ---------- users ----------
    // Dibuat & dihapus HANYA lewat Cloud Functions (buatUser / hapusUser).
    match /users/{userId} {
      allow get: if login() && (uid() == userId || isPembina());
      allow list: if isPembina();

      // Pemilik boleh memperbarui profilnya, tapi tidak role/status/email.
      allow update: if login() && uid() == userId && ubahanAman();
      // Admin boleh mengubah data siapa pun (termasuk role & status).
      allow update: if isAdmin();

      allow create, delete: if false;
    }

    // ---------- kartu ----------
    // Pemetaan sidik nomor seri kartu ke peserta. Tertutup penuh dari browser:
    // menaruhnya di dokumen users berarti setiap pembimbing bisa membacanya,
    // padahal ini satu-satunya hal yang membuat sebuah kartu sah.
    match /kartu/{sidik} {
      allow read, write: if false;
    }

    // ---------- absensi ----------
    // Read-only dari client. Penulisan hanya lewat API route (Admin SDK).
    match /absensi/{docId} {
      // `resource == null` untuk dokumen yang belum ada. Tanpa cabang ini
      // pembacaannya berujung galat penilaian, bukan "tidak ditemukan" —
      // dan peserta yang belum pernah absen tertahan di layar memuat.
      allow get: if login() && (isPembina() || resource == null || resource.data.userId == uid());
      allow list: if login() && (isPembina() || resource.data.userId == uid());
      allow write: if false;
    }

    // ---------- izin ----------
    // Pengajuan dibaca peserta yang bersangkutan dan seluruh pembina.
    // Penulisan hanya lewat API route agar persetujuan sekaligus mencatat
    // absensi — yang tidak boleh disentuh client.
    match /izin/{izinId} {
      allow get: if login() && (isPembina() || resource == null || resource.data.userId == uid());
      allow list: if login() && (isPembina() || resource.data.userId == uid());
      allow write: if false;
    }

    // ---------- kegiatan harian ----------
    // Dibaca peserta yang bersangkutan dan seluruh pembina; ditulis hanya lewat
    // API route, supaya batas menulis mundur dan penguncian setelah diperiksa
    // tidak bisa dilewati dari browser.
    match /aktivitas/{catatan} {
      allow get: if login() && (isPembina() || resource == null || resource.data.userId == uid());
      allow list: if login() && (isPembina() || resource.data.userId == uid());
      allow write: if false;
    }

    // Foto dipisah dari catatannya agar daftar kegiatan tetap ringan dibuka.
    match /aktivitasFoto/{catatan} {
      allow get: if login() && (isPembina() || resource == null || resource.data.userId == uid());
      allow list: if false;
      allow write: if false;
    }

    // ---------- jejak audit ----------
    // Tertutup penuh, termasuk dari admin. Catatan audit yang bisa disunting
    // pelakunya sendiri tidak membuktikan apa pun. Admin membacanya lewat
    // API route, yang hanya melayani pembacaan.
    match /jejak/{catatan} {
      allow read, write: if false;
    }

    // ---------- laporan galat ----------
    // Ditulis dan dibaca lewat API route saja. Kalau bisa ditulis langsung
    // dari browser, koleksinya akan jadi tempat pembuangan sampah.
    match /galat/{laporan} {
      allow read, write: if false;
    }

    // ---------- config ----------
    // Jam kerja, toleransi, titik & radius kantor.
    match /config/{docId} {
      allow read: if login();
      allow write: if isAdmin();
    }

    // ---------- selebihnya ditutup ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
