# Salin file ini menjadi .env.local lalu isi dari Firebase Console
# Project Settings > General > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Jam kerja default (bisa diubah)
NEXT_PUBLIC_JAM_MASUK=08:00
NEXT_PUBLIC_JAM_PULANG=16:00
NEXT_PUBLIC_TOLERANSI_MENIT=15
# Ambang kecocokan wajah (semakin kecil semakin ketat)
NEXT_PUBLIC_FACE_THRESHOLD=0.5
