# Dependency & build
node_modules
.next
out
build
tsconfig.tsbuildinfo

# Environment — jangan pernah di-commit
.env
.env.local
.env*.local

# Kredensial Firebase Admin — akses penuh ke database, wajib di luar Git
*serviceAccount*.json
*firebase-adminsdk*.json
serviceAccountKey.json

# Kunci penanda tangan aplikasi Android — sama gawatnya dengan kredensial di
# atas, tapi dengan satu bahaya tambahan: kalau berkas ini HILANG, aplikasi
# yang sudah dipasang orang tidak bisa diperbarui lagi, selamanya. Simpan
# salinannya di luar Git, di tempat yang tidak ikut terhapus bersama proyek.
*.keystore
*.jks

# Keluaran Bubblewrap dan Android — dibuat ulang setiap kali build
*.apk
*.aab
/android/

# Log & berkas sistem
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor — setelan bersama ikut, sisanya milik masing-masing
.vscode/*
!.vscode/settings.json
.idea

# Firebase CLI
.firebase
firebase-debug.log
